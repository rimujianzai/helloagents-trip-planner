    "jspdf": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "happy-dom": "^21.0.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.0"
  }

          },
          "destination_address": {
            "type": "string",
            "title": "Destination Address",
            "description": "终点地址",
            "example": "北京市海淀区上地十街10号"
          },
          "origin_city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin City",
            "description": "起点城市"
          },
          "destination_city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination City",
            "description": "终点城市"
          },
          "route_type": {

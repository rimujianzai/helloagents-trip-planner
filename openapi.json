{
  "openapi": "3.1.0",
  "info": {
    "title": "HelloAgents智能旅行助手",
    "description": "基于HelloAgents框架的智能旅行规划助手API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/trip/plan": {
      "post": {
        "tags": [
          "旅行规划"
        ],
        "summary": "生成旅行计划",
        "description": "根据用户输入的旅行需求,生成详细的旅行计划",
        "operationId": "plan_trip_api_trip_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPlanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/trip/health": {
      "get": {
        "tags": [
          "旅行规划"
        ],
        "summary": "健康检查",
        "description": "检查旅行规划服务是否正常",
        "operationId": "health_check_api_trip_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/poi/detail/{poi_id}": {
      "get": {
        "tags": [
          "POI"
        ],
        "summary": "获取POI详情",
        "description": "根据POI ID获取详细信息,包括图片",
        "operationId": "get_poi_detail_api_poi_detail__poi_id__get",
        "parameters": [
          {
            "name": "poi_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Poi Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/POIDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/poi/search": {
      "get": {
        "tags": [
          "POI"
        ],
        "summary": "搜索POI",
        "description": "根据关键词搜索POI",
        "operationId": "search_poi_api_poi_search_get",
        "parameters": [
          {
            "name": "keywords",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Keywords"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "北京",
              "title": "City"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/POISearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/poi/photo": {
      "get": {
        "tags": [
          "POI"
        ],
        "summary": "获取景点图片",
        "description": "根据景点名称从Unsplash获取图片",
        "operationId": "get_attraction_photo_api_poi_photo_get",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/map/poi": {
      "get": {
        "tags": [
          "地图服务"
        ],
        "summary": "搜索POI",
        "description": "根据关键词搜索POI(兴趣点)",
        "operationId": "search_poi_api_map_poi_get",
        "parameters": [
          {
            "name": "keywords",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "搜索关键词",
              "examples": [
                "故宫"
              ],
              "title": "Keywords"
            },
            "description": "搜索关键词"
          },
          {
            "name": "city",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "城市",
              "examples": [
                "北京"
              ],
              "title": "City"
            },
            "description": "城市"
          },
          {
            "name": "citylimit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "是否限制在城市范围内",
              "default": true,
              "title": "Citylimit"
            },
            "description": "是否限制在城市范围内"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/POISearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/map/weather": {
      "get": {
        "tags": [
          "地图服务"
        ],
        "summary": "查询天气",
        "description": "查询指定城市的天气信息",
        "operationId": "get_weather_api_map_weather_get",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "城市名称",
              "examples": [
                "北京"
              ],
              "title": "City"
            },
            "description": "城市名称"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/map/route": {
      "post": {
        "tags": [
          "地图服务"
        ],
        "summary": "规划路线",
        "description": "规划两点之间的路线",
        "operationId": "plan_route_api_map_route_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/map/health": {
      "get": {
        "tags": [
          "地图服务"
        ],
        "summary": "健康检查",
        "description": "检查地图服务是否正常",
        "operationId": "health_check_api_map_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "description": "根路径",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "健康检查",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attraction": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "景点名称"
          },
          "address": {
            "type": "string",
            "title": "Address",
            "description": "地址"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ],
            "description": "经纬度坐标(可能缺失, 缺失时不要编造)"
          },
          "visit_duration": {
            "type": "integer",
            "title": "Visit Duration",
            "description": "建议游览时间(分钟)"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "景点描述"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category",
            "description": "景点类别",
            "default": "景点"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating",
            "description": "评分"
          },
          "photos": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photos",
            "description": "景点图片URL列表"
          },
          "poi_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poi Id",
            "description": "POI ID",
            "default": ""
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "description": "图片URL"
          },
          "ticket_price": {
            "type": "integer",
            "title": "Ticket Price",
            "description": "门票价格(元)",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "name",
          "address",
          "visit_duration",
          "description"
        ],
        "title": "Attraction",
        "description": "景点信息"
      },
      "Budget": {
        "properties": {
          "total_attractions": {
            "type": "integer",
            "title": "Total Attractions",
            "description": "景点门票总费用",
            "default": 0
          },
          "total_hotels": {
            "type": "integer",
            "title": "Total Hotels",
            "description": "酒店总费用",
            "default": 0
          },
          "total_meals": {
            "type": "integer",
            "title": "Total Meals",
            "description": "餐饮总费用",
            "default": 0
          },
          "total_transportation": {
            "type": "integer",
            "title": "Total Transportation",
            "description": "交通总费用",
            "default": 0
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "总费用",
            "default": 0
          }
        },
        "type": "object",
        "title": "Budget",
        "description": "预算信息"
      },
      "DayPlan": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date",
            "description": "日期 YYYY-MM-DD"
          },
          "day_index": {
            "type": "integer",
            "title": "Day Index",
            "description": "第几天(从0开始)"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "当日行程描述"
          },
          "transportation": {
            "type": "string",
            "title": "Transportation",
            "description": "交通方式"
          },
          "accommodation": {
            "type": "string",
            "title": "Accommodation",
            "description": "住宿"
          },
          "hotel": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Hotel"
              },
              {
                "type": "null"
              }
            ],
            "description": "推荐酒店"
          },
          "attractions": {
            "items": {
              "$ref": "#/components/schemas/Attraction"
            },
            "type": "array",
            "title": "Attractions",
            "description": "景点列表",
            "default": []
          },
          "meals": {
            "items": {
              "$ref": "#/components/schemas/Meal"
            },
            "type": "array",
            "title": "Meals",
            "description": "餐饮列表",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "date",
          "day_index",
          "description",
          "transportation",
          "accommodation"
        ],
        "title": "DayPlan",
        "description": "单日行程"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hotel": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "酒店名称"
          },
          "address": {
            "type": "string",
            "title": "Address",
            "description": "酒店地址",
            "default": ""
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ],
            "description": "酒店位置"
          },
          "price_range": {
            "type": "string",
            "title": "Price Range",
            "description": "价格范围",
            "default": ""
          },
          "rating": {
            "type": "string",
            "title": "Rating",
            "description": "评分",
            "default": ""
          },
          "distance": {
            "type": "string",
            "title": "Distance",
            "description": "距离景点距离",
            "default": ""
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "酒店类型",
            "default": ""
          },
          "estimated_cost": {
            "type": "integer",
            "title": "Estimated Cost",
            "description": "预估费用(元/晚)",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Hotel",
        "description": "酒店信息"
      },
      "Location": {
        "properties": {
          "longitude": {
            "type": "number",
            "title": "Longitude",
            "description": "经度"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude",
            "description": "纬度"
          }
        },
        "type": "object",
        "required": [
          "longitude",
          "latitude"
        ],
        "title": "Location",
        "description": "地理位置"
      },
      "Meal": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "餐饮类型: breakfast/lunch/dinner/snack"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "餐饮名称"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address",
            "description": "地址"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ],
            "description": "经纬度坐标"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "描述"
          },
          "estimated_cost": {
            "type": "integer",
            "title": "Estimated Cost",
            "description": "预估费用(元)",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "type",
          "name"
        ],
        "title": "Meal",
        "description": "餐饮信息"
      },
      "POIDetailResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "是否成功"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "消息",
            "default": ""
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data",
            "description": "POI详情数据"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "POIDetailResponse",
        "description": "POI详情响应"
      },
      "POIInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "POI ID"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "名称"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "类型",
            "default": ""
          },
          "address": {
            "type": "string",
            "title": "Address",
            "description": "地址",
            "default": ""
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ],
            "description": "经纬度坐标(搜索结果可能缺失, 需用POI详情补齐)"
          },
          "typecode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Typecode",
            "description": "高德POI分类编码"
          },
          "tel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tel",
            "description": "电话"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "POIInfo",
        "description": "POI信息"
      },
      "POISearchResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "是否成功"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "消息",
            "default": ""
          },
          "data": {
            "items": {
